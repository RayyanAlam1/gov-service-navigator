# ─────────────────────────────────────────────────────────────────────────────
# Government Service AI Navigator — environment configuration
#
# Copy to .env.local (dev) or .env (docker) and fill in. Nothing here is
# required: the system is designed to boot and run in a degraded-but-honest
# mode with zero credentials, and /api/health reports exactly which
# capabilities are live. See docs/CONFIGURATION.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info
PORT=3000

# ── Database ─────────────────────────────────────────────────────────────────
# DB_DRIVER=pg      -> real PostgreSQL (docker compose / managed). Needs pgvector.
# DB_DRIVER=pglite  -> embedded Postgres (WASM) written to .pglite/. Zero infra.
#                      Same SQL, same schema, same seeds. Used for CI, for
#                      offline development, and as a demo-day safety net.
DB_DRIVER=pg
DATABASE_URL=postgresql://gsn:gsn_dev_password@localhost:5432/gsn
PGLITE_DATA_DIR=.pglite
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000

# ── LLM provider ─────────────────────────────────────────────────────────────
# Providers are tried in order: LLM_PROVIDER, then LLM_FALLBACK_PROVIDER, then
# the built-in deterministic provider. A provider with no key is skipped, and
# one whose circuit breaker is open is stepped over until it cools down.
#
#   dashscope -> Alibaba Cloud Model Studio (Qwen), OpenAI-compatible mode
#   groq      -> Groq free tier (chat only; Groq has no embeddings endpoint)
#   mock      -> deterministic offline provider, always available
LLM_PROVIDER=dashscope
LLM_FALLBACK_PROVIDER=groq

# ── Alibaba Cloud Model Studio (DashScope) ───────────────────────────────────
# Console: https://bailian.console.alibabacloud.com/
# Use the -intl base URL for the Singapore region, the plain one for Beijing.
DASHSCOPE_API_KEY=
# Multiple keys are supported and preferred; the pool round-robins, parses
# rate-limit headers, cools a key on HTTP 429 and retires one on HTTP 401.
DASHSCOPE_API_KEYS=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL_PRIMARY=qwen-plus
DASHSCOPE_MODEL_FAST=qwen-turbo
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# ── Groq (fallback) ──────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# ── LLM behaviour ────────────────────────────────────────────────────────────
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=2048
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=86400
# After N consecutive provider failures, stop calling it for M ms and move down
# the chain instead of hanging the request.
LLM_BREAKER_THRESHOLD=5
LLM_BREAKER_COOLDOWN_MS=30000

# ── Embeddings ───────────────────────────────────────────────────────────────
# local     -> multilingual ONNX model in-process. Free, offline after the
#              first fetch (npm run model:fetch). 384 dimensions.
# dashscope -> Alibaba text-embedding-v3. Set EMBEDDING_DIM to a width the
#              model supports (1024 / 768 / 512 / 256 / 128 / 64), then
#              `npm run db:migrate -- --reset && npm run db:seed`.
# hash      -> dependency-free deterministic fallback. Lexical quality only;
#              hybrid BM25 retrieval carries it. /api/health flags it degraded.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/multilingual-e5-small
# MUST match the vector(N) width the migrations were applied with. The runner
# records the width in system_meta and refuses to start on a mismatch.
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=16
TRANSFORMERS_CACHE=./data/models

# ── Retrieval ────────────────────────────────────────────────────────────────
RAG_TOP_K=8                    # chunks handed to the composer after reranking
RAG_CANDIDATE_K=24             # candidates pulled from each retrieval arm
# Similarity thresholds are MODEL-SPECIFIC. e5-family models compress cosine
# similarity into a narrow high band, so a value copied from another model
# filters nothing. Re-derive both with `npm run probe` after changing models.
RAG_MIN_SIMILARITY=0.75        # below this a chunk is not shown as evidence
RAG_SUFFICIENCY_SIMILARITY=0.84  # below this we do NOT claim a topic is documented
RAG_RRF_K=60                   # reciprocal-rank-fusion smoothing constant
RAG_MAX_QUERY_EXPANSIONS=3
RAG_MAX_RETRIEVAL_LOOPS=2      # agentic re-query budget per turn
RAG_RERANK_ENABLED=true

# ── Grounding & safety ───────────────────────────────────────────────────────
# How stale a source may be before its claims are demoted to "could not be
# verified" in the UI.
SOURCE_STALE_AFTER_DAYS=180
# Minimum confidence to auto-select a service without asking the citizen.
SERVICE_CONFIDENCE_THRESHOLD=0.62
# Refuse to render any claim the output verifier cannot trace back to a fact.
STRICT_GROUNDING=true

# ── Session & limits ─────────────────────────────────────────────────────────
SESSION_TTL_HOURS=72
SESSION_ID_BYTES=32
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
MAX_INPUT_CHARS=1200
MAX_UPLOAD_BYTES=5242880

# ── Document intelligence ────────────────────────────────────────────────────
# mock is the only supported value: no real citizen ID is ever uploaded.
OCR_PROVIDER=mock
# Uploaded bytes are processed in memory and discarded. Do not enable retention
# without a lawful basis and a written retention policy.
DOCUMENT_RETENTION_ENABLED=false
